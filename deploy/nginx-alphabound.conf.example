# Example nginx edge for AlphaBound (TLS terminate + reverse proxy).
# Copy to sites-available, replace YOUR_DOMAIN, point cert paths, enable site.
#
# App must bind loopback only, e.g. [web] bind = "127.0.0.1:8080"
# secrets.env on the host:
#   ALPHABOUND_TRUST_PROXY=1
#   ALPHABOUND_TRUSTED_PROXY_HOPS=1
#   ALPHABOUND_WEBAUTHN_RP_ID=YOUR_DOMAIN
#   ALPHABOUND_WEBAUTHN_ORIGIN=https://YOUR_DOMAIN
#
# Cloudflare (optional): DNS A/AAAA → origin, proxy orange-cloud;
# SSL/TLS mode Full (origin may use self-signed or public cert).
# Do not use Flexible (origin HTTP) if you rely on X-Forwarded-Proto=https.

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_DOMAIN;

    ssl_certificate     /etc/nginx/ssl/YOUR_DOMAIN.crt;
    ssl_certificate_key /etc/nginx/ssl/YOUR_DOMAIN.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    client_max_body_size 4m;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    proxy_connect_timeout 10s;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # Append client; AlphaBound FailGuard uses right-most hop when hops=1
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_pass http://127.0.0.1:8080;
        proxy_buffering off;
    }
}
