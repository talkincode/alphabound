# Example nginx edge for the AlphaBound analytics MCP gateway (`alphabound-mcp --http`).
# Copy to sites-available, replace YOUR_MCP_DOMAIN, point cert paths, enable site.
#
# Give the gateway its OWN hostname: OAuth metadata (/.well-known/..., /authorize,
# /token, /register) lives at the root of that origin.
#
# The gateway binds loopback only. Its environment (EnvironmentFile; never commit
# real values):
#   ALPHABOUND_API_BASE=http://127.0.0.1:8080       # the daemon
#   ALPHABOUND_API_TOKEN=...                        # shared with the daemon; approves OAuth clients
#   ALPHABOUND_MCP_BIND=127.0.0.1
#   ALPHABOUND_MCP_PORT=8723
#   ALPHABOUND_MCP_OAUTH=1
#   ALPHABOUND_MCP_PUBLIC_URL=https://YOUR_MCP_DOMAIN
#   ALPHABOUND_MCP_OAUTH_STATE_FILE=/var/lib/alphabound-mcp/oauth.json   # 0600, writable by the service user
#   ALPHABOUND_MCP_TRUST_PROXY=1                    # exactly one proxy (this nginx) in front
#
# Clients then add https://YOUR_MCP_DOMAIN/mcp as a remote MCP server.

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_MCP_DOMAIN;
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_MCP_DOMAIN;

    ssl_certificate     /etc/nginx/ssl/YOUR_MCP_DOMAIN.crt;
    ssl_certificate_key /etc/nginx/ssl/YOUR_MCP_DOMAIN.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    # Tool calls and OAuth forms are tiny.
    client_max_body_size 1m;
    proxy_read_timeout 60s;
    proxy_connect_timeout 10s;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        # Append client; the gateway uses the right-most hop when TRUST_PROXY=1
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_pass http://127.0.0.1:8723;
    }
}
