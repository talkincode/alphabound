# Copy via: ./scripts/load-okx-keychain.sh  (OKX only)
# Or fill manually and chmod 600. Never commit real values.
# Source: set -a && source ./secrets.env && set +a

# --- OKX (exchange) ---
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# OKX_SIMULATED=0
# Explicit opt-in: allow demo-mode execution with REAL keys (small
# sub-account only; never default). See docs/GATE3_CHECKLIST.md.
# OKX_REAL_MONEY_OK=0

# --- LLM OpenAI-compatible agent ---
# Required to enable slow-loop decisions in shadow:
LLM_API_KEY=
# API root WITHOUT /chat/completions suffix:
LLM_API_URL=https://api.openai.com/v1
# Model id as your provider expects:
LLM_MODEL=gpt-4o-mini

# Aliases also accepted:
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Dashboard / MCP auth (optional; empty = open local API) ---
# When set, all /api/v1/* data routes require Bearer or X-API-Token,
# or a browser session cookie after /api/v1/auth/login.
# ALPHABOUND_API_TOKEN=
# Passkey (WebAuthn) origin must match the URL you open in the browser:
# ALPHABOUND_WEBAUTHN_RP_ID=localhost
# ALPHABOUND_WEBAUTHN_ORIGIN=http://127.0.0.1:8080
